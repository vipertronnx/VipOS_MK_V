## Copy this file to .env and fill in real values. Do not commit .env.

# Server
PORT=5000
APP_NAME=VipOS MK V
APP_DESCRIPTION=Chat Bot + Overlay Platform

# OBS WebSocket
# Keep disabled until OBS_ADDRESS and OBS_PASSWORD are configured.
OBS_ENABLED=false
OBS_ADDRESS=ws://localhost:4455
OBS_PASSWORD=
OBS_RECONNECT_RETRY_INTERVAL=5000

# Twitch chat and EventSub
# Keep disabled until the bot credentials and channel are configured.
CHAT_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bot account scopes: user:read:chat user:write:chat
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_SCOPES=user:read:chat user:write:chat
TWITCH_TOKEN_FILE=config/twitch-token.json

# Optional bot identity values; the service looks them up when they are absent.
TWITCH_BOT_USER_ID=
TWITCH_BOT_USERNAME=

# Set either the channel login or ID. The ID avoids one lookup.
TWITCH_CHANNEL=
TWITCH_CHANNEL_ID=
CHAT_COMMAND_PREFIX=!
CHAT_COMMANDS_FILE=config/commands.json
CHAT_IGNORE_SELF=true
CHAT_RECONNECT_INITIAL_MS=5000
CHAT_RECONNECT_MAX_MS=60000

# Highlighted chat messages
CHAT_ENABLE_HIGHLIGHT_ALERTS=false
TWITCH_HIGHLIGHT_REWARD_ID=

# Broadcaster-authenticated events
# Redemptions need channel:read:redemptions or channel:manage:redemptions.
# Follows need moderator:read:followers. Subscriptions need channel:read:subscriptions.
CHAT_ENABLE_REDEMPTIONS=false
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=
# Copy the exact scopes returned with the broadcaster token.
TWITCH_BROADCASTER_SCOPES=
TWITCH_BROADCASTER_TOKEN_FILE=config/twitch-broadcaster-token.json

# Sounds and action queue
# Sound paths are relative to public/assets/sounds/.
DEFAULT_ALERT_SOUND=example.mp3
QUEUE_SOUND_COMPLETION_BUFFER_MS=250
QUEUE_SOUND_COMPLETION_DELAY_MS=4000

# Raffle
# Detailed settings and persisted state live in config/raffle.json.
RAFFLE_ENABLED=false
# RAFFLE_ENTRY_COMMAND=!join
# RAFFLE_POINTS_COMMAND=!points
# RAFFLE_COUNTDOWN_INTERVAL_MS=30000
# RAFFLE_ENTRY_WINDOW_MS=120000
# RAFFLE_MIN_DELAY_MS=300000
# RAFFLE_MAX_DELAY_MS=600000
# RAFFLE_MAX_HISTORY=50
# RAFFLE_POINT_AMOUNTS=[100,150,200,250,300,350,400,450,500]
# RAFFLE_POINT_NAME=raffle points
# RAFFLE_POINT_TWITCH_EMOJI=
# RAFFLE_ALERT_SOUND=example.mp3

# News chyron
NEWS_CHYRON_ROTATE_INTERVAL_MS=30000
NEWS_CHYRON_ITEMS_DEFAULT=config/examples/news-chyron.example.json
# NEWS_CHYRON_ITEMS=config/news-chyron.json
NEWS_CHYRON_LOWER_THIRD_SLIDE_DISTANCE=140px
NEWS_CHYRON_LOWER_THIRD_SLIDE_DURATION=600ms

# TV Guide
TV_GUIDE_ITEMS_DEFAULT=config/examples/tv-guide.example.json
# TV_GUIDE_ITEMS=config/tv-guide.json

# Venom Coin
VENOM_COIN_LOWER_THIRD_SLIDE_DISTANCE=100%
VENOM_COIN_LOWER_THIRD_SLIDE_DURATION=300ms

# Shared news-chyron and Venom Coin visibility timer. A value of 0 disables
# the automatic transition out of that state.
LOWER_THIRD_VISIBLE_DURATION_MS=180000
LOWER_THIRD_HIDDEN_DURATION_MS=180000
# JSON array of OBS program scenes that keep both shared lower thirds visible.
# LOWER_THIRD_ALWAYS_VISIBLE_OBS_SCENES=["Gameplay","Just Chatting"]
# JSON array of OBS program scenes that always keep both shared lower thirds hidden.
# LOWER_THIRD_ALWAYS_HIDDEN_OBS_SCENES=["Starting Soon","BRB"]
